+];
+
+var DISRUPTION_KINDS = [
+  {id:'weather',  label:'Weather',     colour:'#254E91'},
+  {id:'notam',    label:'NOTAMs',      colour:'#7A4E00'},
+  {id:'atfm',     label:'ATFM',        colour:'#1F5C68'},
+  {id:'strike',   label:'Strikes',     colour:'#5B4A9F'},
+  {id:'wildfire', label:'Wildfires',   colour:'#8B1A1A'},
+  {id:'disaster', label:'Disasters',   colour:'#4338CA'},
+  {id:'volcanic', label:'Volcanic',    colour:'#7A4E00'},
+  {id:'news',     label:'Incidents',   colour:'#1A5C3A'},
+];
+
+var mapState = { map:null, layersByKind:{}, activeKinds:{} };
+
+function initDisruptionMap(){
+  if (mapState.map) return;
+  if (typeof L === 'undefined') return;
+
+  var profile = DIOCore.getDIOProfile();
+  var territory = DIOTerritory.getTerritory(profile.uid);
+  var centre = territory.short_label === 'UK + IE' ? [54.5,-3.5]
+             : territory.short_label === 'FR'      ? [46.5, 2.5]
+             : territory.short_label === 'ES'      ? [40.0,-3.5]
+             : [48, 5];
+  var zoom = 5;
+
+  mapState.map = L.map('disruption-map', {zoomControl:true, worldCopyJump:true, minZoom:3, maxZoom:10}).setView(centre, zoom);
+  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
+    attribution:'&copy; OpenStreetMap',
+    maxZoom:19
+  }).addTo(mapState.map);
+
+  // Group items by kind, count, and create a layer per kind
+  var byKind = {};
+  DISRUPTION_KINDS.forEach(function(k){ byKind[k.id] = []; mapState.activeKinds[k.id] = true; });
+  DISRUPTION_SEED.forEach(function(e){
+    if (byKind[e.kind]) byKind[e.kind].push(e);
+  });
+
+  DISRUPTION_KINDS.forEach(function(k){
+    var lg = L.layerGroup();
+    byKind[k.id].forEach(function(e){
+      var marker = L.circleMarker([e.lat, e.lon], {
+        radius: 8,
+        color: '#fff',
+        weight: 2,
+        fillColor: k.colour,
+        fillOpacity: 0.85
+      });
+      marker.bindPopup(
+        '<div class="lp-kind">'+escapeHtml(k.label)+'</div>'+
+        '<div class="lp-title">'+escapeHtml(e.title)+'</div>'+
+        '<div>'+escapeHtml(e.meta)+'</div>'+
+        '<div class="lp-meta">'+escapeHtml(e.when)+'</div>'
+      );
+      lg.addLayer(marker);
+    });
+    lg.addTo(mapState.map);
+    mapState.layersByKind[k.id] = lg;
+  });
+
+  // Render filter chips with counts
+  var bar = document.getElementById('map-filter-bar');
+  if (bar){
+    bar.innerHTML = DISRUPTION_KINDS.map(function(k){
+      var count = byKind[k.id].length;
+      return '<button class="map-chip on '+k.id+'" data-kind="'+k.id+'" onclick="toggleMapKind(\''+k.id+'\')">'+
+             '<span class="dot"></span>'+
+             '<span>'+k.label+'</span>'+
+             '<span class="map-chip-count">'+count+'</span>'+
+             '</button>';
+    }).join('');
+  }
+}
+
+function toggleMapKind(kindId){
+  if (!mapState.map || !mapState.layersByKind[kindId]) return;
+  mapState.activeKinds[kindId] = !mapState.activeKinds[kindId];
+  if (mapState.activeKinds[kindId]) {
+    mapState.layersByKind[kindId].addTo(mapState.map);
+  } else {
+    mapState.map.removeLayer(mapState.layersByKind[kindId]);
+  }
+  var chip = document.querySelector('.map-chip[data-kind="'+kindId+'"]');
+  if (chip) {
+    chip.classList.toggle('on', mapState.activeKinds[kindId]);
+    chip.classList.toggle('off', !mapState.activeKinds[kindId]);
+  }
+}
