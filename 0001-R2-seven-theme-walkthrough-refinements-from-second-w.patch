+    </div>
+  </div>
+</div>
+
+<script>
+(function(){
+  var CATALOGUE = [
+    {id:'metar',      label:'METAR / TAF observations',           source:'AviationWeather.gov'},
+    {id:'sigmet',     label:'SIGMET / AIRMET warnings',           source:'AviationWeather.gov'},
+    {id:'metoffice',  label:'Met Office synoptic chart · SIGWX',  source:'Met Office DataHub'},
+    {id:'notam',      label:'NOTAMs · airport / airspace',        source:'FAA + AutoRouter'},
+    {id:'atfm',       label:'Eurocontrol ATFM regulation',        source:'Eurocontrol NM'},
+    {id:'crco',       label:'Eurocontrol CRCO reference',         source:'Eurocontrol NM'},
+    {id:'oplog',      label:'Operational delay records (ATD/ATA)',source:'internal · ops-log'},
+    {id:'commander',  label:'Commander report + ACARS trace',     source:'internal · ACARS'},
+    {id:'crew',       label:'Crew FDP / roster records',          source:'internal · AIMS'},
+    {id:'article9',   label:'Article 9 duty-of-care vouchers',    source:'internal · MAX OPS'},
+    {id:'rerouting',  label:'Third-party rerouting evidence',     source:'internal · scheduling'},
+    {id:'strike',     label:'Third-party industrial-action notice',source:'DGAC / ENAC / news'},
+    {id:'news',       label:'Aviation Herald incident report',    source:'Aviation Herald'},
+    {id:'wildfire',   label:'Wildfire proximity data',            source:'NASA FIRMS / Copernicus'},
+    {id:'volcanic',   label:'Volcanic ash advisory',              source:'VAAC London / Toulouse'},
+    {id:'flight',     label:'Flight track (OpenSky)',             source:'OpenSky Network'},
+  ];
+  function renderCat(){
+    var host = document.getElementById('dio-req-cat-list');
+    if (!host) return;
+    host.innerHTML = CATALOGUE.map(function(it){
+      return '<label class="dio-req-cat-item">'+
+             '<input type="checkbox" class="dio-req-check" data-id="'+it.id+'" data-label="'+it.label+'" data-src="'+it.source+'">'+
+             '<span style="flex:1"><strong>'+it.label+'</strong><span class="src">'+it.source+'</span></span>'+
+             '</label>';
+    }).join('');
+  }
+  window.openDioReqModal = function(){
+    var ref = (typeof CASE_REF !== 'undefined') ? CASE_REF : '';
+    var refEl = document.getElementById('dio-req-case-ref');
+    if (refEl) refEl.textContent = ref;
+    document.getElementById('dio-req-overlay').classList.add('open');
+    renderCat();
+    switchDioReqTab('quick');
+  };
+  window.closeDioReqModal = function(){
+    document.getElementById('dio-req-overlay').classList.remove('open');
+  };
+  window.switchDioReqTab = function(which){
+    var q = document.getElementById('dio-req-tab-quick');
+    var f = document.getElementById('dio-req-tab-freeform');
+    var qp = document.getElementById('dio-req-panel-quick');
+    var fp = document.getElementById('dio-req-panel-freeform');
+    var sb = document.getElementById('dio-req-submit');
+    if (which === 'quick'){
+      q.classList.add('on'); f.classList.remove('on');
+      qp.style.display = ''; fp.style.display = 'none';
+      if (sb) sb.innerHTML = '<i class="ti ti-send"></i> Add to Requests forum';
+    } else {
+      f.classList.add('on'); q.classList.remove('on');
+      fp.style.display = ''; qp.style.display = 'none';
+      if (sb) sb.innerHTML = '<i class="ti ti-send"></i> Raise';
+    }
+  };
+  window.submitDioReq = function(){
+    var ref = (typeof CASE_REF !== 'undefined') ? CASE_REF : '';
+    if (!ref){ alert('No case reference — open a case first.'); return; }
+    var qp = document.getElementById('dio-req-panel-quick');
+    var quickMode = qp && qp.style.display !== 'none';
+    var items = [];
+    if (quickMode){
+      Array.prototype.forEach.call(document.querySelectorAll('.dio-req-check:checked'), function(c){
+        items.push({id:c.getAttribute('data-id'), label:c.getAttribute('data-label'), source:c.getAttribute('data-src')});
+      });
+      if (!items.length){ alert('Tick at least one item.'); return; }
+    } else {
+      var txt = document.getElementById('dio-req-freeform-text').value.trim();
+      if (!txt){ alert('Describe the document.'); return; }
+      items.push({id:'freeform-'+Date.now(), label:txt, source:'freeform'});
+    }
+    /* Write to the case's evidenceRequests store so the Requests forum picks them up */
+    try {
+      var uid = (typeof getActiveUser === 'function') ? getActiveUser() : 'EH';
+      var st = DIO.getEvidenceState(ref) || {};
+      st.evidenceRequests = st.evidenceRequests || {};
+      var now = Date.now();
+      items.forEach(function(it, i){
+        var reqId = it.id + '-' + now + '-' + i;
+        st.evidenceRequests[reqId] = {
+          id: reqId,
+          name: it.label,
+          status: 'pending',
+          caseRef: ref,
+          requestedBy: (typeof USERS !== 'undefined' && USERS[uid] ? USERS[uid].name : uid),
+          requestedAt: new Date().toLocaleString('en-GB'),
+          requestedAtMs: now,
+          slaDays: 3,
+          source: it.source,
+          origin: 'dio-raised'
+        };
+      });
+      DIO.saveEvidenceState(ref, st);
+      var label = quickMode ? (items.length + ' item' + (items.length===1?'':'s') + ' added to Requests forum') : 'Freeform request raised';
+      if (typeof showToast === 'function') showToast(label);
+      else alert(label);
+    } catch(e){
+      alert('Could not save request: '+e.message);
+    }
+    closeDioReqModal();
+    if (typeof render === 'function') render();
+  };
+})();
+</script>
 </body>
 </html>
