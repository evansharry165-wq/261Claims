+<!-- R2.E · DIO Raise-request modal (mirror of lawyer S3 flow) -->
+<style>
+.dio-req-fab{position:fixed;bottom:24px;right:24px;background:var(--accent,#1B3A6B);color:#fff;border:none;border-radius:24px;padding:12px 20px;font-size:13px;font-weight:600;font-family:var(--font,'Helvetica Neue',Arial,sans-serif);cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,0.25);display:inline-flex;align-items:center;gap:8px;z-index:400;transition:transform .1s,box-shadow .12s}
