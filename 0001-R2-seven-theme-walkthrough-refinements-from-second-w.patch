+      <button id="dio-req-tab-freeform" onclick="switchDioReqTab('freeform')"><i class="ti ti-pencil"></i> Freeform · specific document</button>
+    </div>
+    <div id="dio-req-panel-quick" class="dio-req-body">
+      <div class="dio-req-note" style="margin-bottom:10px">Tick items you need. Available items pull from the case Evidence Repository; missing items raise a targeted request. Ticked items land in the shared Requests forum for pickup.</div>
+      <div id="dio-req-cat-list" class="dio-req-cat-list"></div>
