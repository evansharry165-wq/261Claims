+.dio-req-tabs button.on{color:#1B3A6B;font-weight:600;border-bottom-color:#1B3A6B}
+.dio-req-body{padding:16px 20px}
+.dio-req-cat-list{max-height:280px;overflow-y:auto;border:1px solid #D8D8E0;border-radius:3px}
+.dio-req-cat-item{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid #EBEBF0;cursor:pointer;font-size:12px}
